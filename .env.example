# Glow Star Pricing System — environment variables.
# Copy to `.env` and fill in. NEVER commit real secrets (brief Section 11).
# The credentials currently in API-Documentation.docx are COMPROMISED and must
# be rotated and re-delivered securely before production use.

# --- Diamanto (auth token + internal price-grid history) ---
DIAMANTO_USERNAME=
DIAMANTO_PASSWORD=
DIAMANTO_CLIENT_ID=ngAuthApp
DIAMANTO_UDID=

# --- Uni Diamonds (market comparables feed) ---
UNI_DEVICE_ID=
UNI_TOKEN=
UNI_PLATFORM=

# --- Channel Partner (inventory + sales) ---
# NOTE: this endpoint passes credentials in the URL path — ensure HTTPS
# end-to-end and never log full request URLs.
CHANNEL_PARTNER_USER=
CHANNEL_PARTNER_PASS=

# --- Anthropic Claude API (LLM narration layer; numbers passed in, never generated) ---
ANTHROPIC_API_KEY=
GS_LLM_MODEL=claude-opus-4-8

# --- Optional path overrides (default to repo root files) ---
# GS_RECORDS=records.json
# GS_RAP_ROUND=CSV2_ROUND_8_4.csv
# GS_RAP_PEAR=CSV2_PEAR_8_4.csv

# --- Optional tuning overrides (see glowstar/config.py) ---
# GS_BACKTEST_SPLIT=2026-05-01
# GS_MIN_SEGMENT_SAMPLES=30
# GS_INTERVAL_COVERAGE=0.80
# GS_HIGH_VALUE_USD=50000
