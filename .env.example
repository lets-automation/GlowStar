# Glow Star Pricing System — environment variables.
# Copy to `.env` and fill in. NEVER commit real secrets (brief Section 11).
# The credentials currently in API-Documentation.docx are COMPROMISED and must
# be rotated and re-delivered securely before production use.

# --- Diamanto (auth token + internal price-grid history) ---
DIAMANTO_USERNAME=
DIAMANTO_PASSWORD=
DIAMANTO_CLIENT_ID=ngAuthApp
DIAMANTO_UDID=

# --- Uni Diamonds (market comparables feed) ---
UNI_DEVICE_ID=
UNI_TOKEN=
UNI_PLATFORM=

# --- Channel Partner (inventory + sales) ---
# NOTE: this endpoint passes credentials in the URL path — ensure HTTPS
# end-to-end and never log full request URLs.
CHANNEL_PARTNER_USER=
CHANNEL_PARTNER_PASS=

# --- Anthropic Claude API (LLM narration layer; numbers passed in, never generated) ---
ANTHROPIC_API_KEY=
GS_LLM_MODEL=claude-opus-4-8

# --- Optional path overrides (default to repo root files) ---
# GS_RECORDS=records.json
# GS_RAP_ROUND=CSV2_ROUND_8_4.csv
# GS_RAP_PEAR=CSV2_PEAR_8_4.csv

# --- Optional tuning overrides (see glowstar/config.py) ---
# GS_BACKTEST_SPLIT=2026-05-01
# GS_MIN_SEGMENT_SAMPLES=30
# GS_INTERVAL_COVERAGE=0.80
# GS_HIGH_VALUE_USD=50000

# =====================================================================
# PRODUCTION DEPLOYMENT (see deploy/install.sh). None of these are needed
# to run locally — every one has a safe default for development.
# =====================================================================

# --- Service hardening ---
# GS_ENV=production makes the app REFUSE TO START without GS_API_KEY, so an
# unauthenticated pricing endpoint can never be exposed by accident.
GS_ENV=production
# Shared secret the client's CRM sends as the X-API-Key header. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
GS_API_KEY=

# Requests allowed per caller per minute before the API answers 429.
# The client declined an IP allowlist, so the key is the only fence and a
# runaway retry loop on their side could otherwise saturate the box and starve
# the 02:30 retrain. 120/min is far above real desk usage; it only engages on a
# loop. NOTE: each uvicorn worker counts separately, so the effective ceiling is
# roughly this x2 — it is a blast shield, not a quota. Set to 0 to disable for a
# bulk migration or load test.
GS_RATE_LIMIT=120
# GS_RATE_WINDOW_S=60

# --- Database ---
# UNSET  -> SQLite at data/glowstar.db (local/dev/tests)
# SET    -> PostgreSQL (production). Same schema, same code; this variable is
#           the ONLY difference between a laptop and the production server.
GS_DATABASE_URL=postgresql+psycopg://glowstar:CHANGEME@localhost/glowstar
# Used once by deploy/install.sh to create the database role.
GS_DB_PASSWORD=

# --- Backups (deploy/backup.sh, run nightly) ---
# data/master_grid/history.json CANNOT be rebuilt: the grid API only serves a
# short window, so a day that passes unrecorded is gone permanently, and without
# it the grid model cannot be honestly validated. Treat this as the one
# unrecoverable asset in the system.
GS_BACKUP_DIR=/var/backups/glowstar
# Off-server copy. A backup on the same disk is not a backup.
GS_BACKUP_AZURE_URL=

# --- Feedback learning (leave OFF) ---
# Measured: training on the desk's returned prices costs ~+0.9 MAE, because a
# returned price is an ASKING QUOTE, not a realized sale. `python -m
# glowstar.feedback.readiness` reports when there is enough data to re-test this
# properly. Do not set this to 1 on a hunch.
GS_USE_FEEDBACK=0

# --- Remaining optional overrides (all have working defaults; listed so the
#     full set is discoverable rather than hidden in config.py) ---
# GS_UNI_BULK=UNI_BGMFILEDWITH.json     # static bulk dump (dev only; prefer live)
# GS_UNI_SAMPLE=response-uni.json       # sample payload for offline tests
# GS_RAP_HISTORY=Rap_history.csv        # historical Rap lists
# GS_CELLS_HISTORY=                     # raw grid-history snapshot path
# GS_FDISCOUNT_MIN=-95                  # outlier guard on the training target
# GS_FDISCOUNT_MAX=0
# GS_USE_BGM=1                          # 0 disables the tinge features (ablation)
