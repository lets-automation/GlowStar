# Secrets & env
.env
*.pem

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/

# Artifacts / models / snapshots
artifacts/
data/snapshots/

# Banked Master grid: the live sheet (current.json) and the POINT-IN-TIME edit
# history the grid model trains on. Large (~100MB+) and machine-local, so not in
# git — but history.json is NOT reproducible from a later pull: it is what a cell
# read on the day a stone was priced. Losing it means the grid model cannot be
# honestly validated (today's grid explaining a past sale is leakage). BACK IT UP;
# rebuild only via `glowstar.market.grid_history.bank_history(days=N)`.
data/master_grid/

# Local SQLite store (quotes/decisions/scores). Machine-local runtime state that
# every dev and the server generate for themselves — committing it would replay
# one machine's test rows onto another. Production uses PostgreSQL; this file
# only exists when GS_DATABASE_URL is unset.
data/glowstar.db
data/glowstar.db-wal
data/glowstar.db-shm

MOU.md

# Large reference dumps (provided out-of-band, never committed)
UNI_BGMFILEDWITH.json
response.json
records.json
deploy-bundle.tar.gz

# Backups pulled DOWN from the server for safekeeping. Data, not source, and
# large — belongs off-box, not in git.
server-backups/
